# Скопируйте в .env и задайте значения (при запуске через npm start переменные нужно экспортировать в окружение)
PORT=3000
HOST=0.0.0.0
# Путь к файлу базы данных SQLite (по умолчанию server/data/smartassign.db)
DB_PATH=
# Секрет подписи токенов JWT: обязательно задайте свой в режиме production
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
